{
  "$schema": "./node_modules/turbo/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "//#check": {},
    "//#fix": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      // Turbo defaults to strict env mode, which hides every variable the task
      // did not declare. Without these the dev servers never see the Dev
      // Container's REDIS_URL and silently fall back to redis://localhost:6379
      // (and to the default API origins), so the shared cache handler talks to
      // the wrong Redis — or to none at all.
      "passThroughEnv": ["PUBLIRA_*", "REDIS_URL"],
      "persistent": true
    },
    "generate:api": {
      "outputs": ["packages/api-client/src/gen/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "inputs": ["**/*.test.{ts,tsx}"]
    },
    "typegen": {
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
