# Safe, repository-defined quality commands may run without an approval prompt.
prefix_rule(
    pattern = ["pnpm", ["preflight", "check", "typecheck", "typegen", "test"]],
    decision = "allow",
    justification = "Allow Publira's checked-in quality scripts.",
    match = [
        "pnpm preflight",
        "pnpm check",
        "pnpm typecheck",
        "pnpm typegen",
        "pnpm test",
    ],
    not_match = [
        "pnpm fix",
        "pnpm install",
        "pnpm dev",
    ],
)

# `pnpm test` parses `--filter` itself and skips Turborepo, so one package's
# tests run as `pnpm run test --filter <package>`.
prefix_rule(
    pattern = ["pnpm", "run", "test"],
    decision = "allow",
    justification = "Allow running one package's tests through Turborepo.",
    match = ["pnpm run test --filter @publira/web-admin"],
    not_match = ["pnpm run dev"],
)

# Formatting is intentionally separate because it modifies workspace files.
# It remains bounded by the workspace-write sandbox.
prefix_rule(
    pattern = ["pnpm", "fix"],
    decision = "allow",
    justification = "Allow Publira's checked-in formatter within the workspace.",
    match = ["pnpm fix"],
    not_match = ["pnpm install"],
)
