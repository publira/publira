{
  "$schema": "./node_modules/turbo/schema.json",
  // Turborepo 2.8+ hands every git worktree the main checkout's `.turbo/cache`
  // unless `cacheDir` is set to a relative path, which resolves from the
  // current worktree instead. That sharing has to stay off. An artifact is
  // restored byte for byte, and a `.next` build writes its own absolute path
  // into `required-server-files.json` and `standalone/`, so a hit hands this
  // worktree an app whose server points at another branch's checkout — or at a
  // worktree that has since been deleted.
  "cacheDir": ".turbo/cache",
  // Local cache eviction (Turborepo 2.10+). Without a limit `.turbo/cache`
  // only ever grows, and an unshared cache spends this budget once per
  // worktree, so a dozen branches each keep their own copy — hence a figure
  // far below what a single shared directory could afford. A whole app build
  // tars to a little over 20 MB, so 1 GB still holds several states of every
  // app at once. Both limits are enforced at the start of every `turbo run`,
  // oldest entry first.
  "cacheMaxAge": "3d",
  "cacheMaxSize": "1GB",
  "globalDependencies": ["**/.env.*local", "locales/**"],
  "tasks": {
    "//#check": {},
    "//#fix": {
      "cache": false,
    },
    "build": {
      "dependsOn": ["^build"],
      // `.next/dev` belongs to `next dev`, which no build task writes: it is
      // whatever the dev server last left in the same directory. Capturing it
      // made an entry several times larger than the build inside it, and
      // restoring one drops another branch's dev state onto a running dev
      // server.
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"],
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      // Turbo defaults to strict env mode, which hides every variable the task
      // did not declare. Without this the dev servers never see the Dev
      // Container's PUBLIRA_REDIS_URL and silently fall back to
      // redis://localhost:6379 (and to the default API origins), so the shared
      // cache handler talks to the wrong Redis — or to none at all. Every
      // variable this repository's own code reads is PUBLIRA_*-prefixed (see
      // the env var naming section of AGENTS.md), so the one pattern covers
      // them all and a new variable needs no entry here. The OpenTelemetry
      // SDK reads OTEL_* itself and Next.js reads NEXT_OTEL_*, so those two
      // patterns are listed as well; without them the dev servers export
      // spans nowhere while the Dev Container thinks it configured Jaeger.
      "passThroughEnv": ["NEXT_OTEL_*", "OTEL_*", "PUBLIRA_*"],
      "persistent": true,
    },
    "generate:api": {
      "outputs": ["packages/api-client/src/gen/**"],
    },
    "lint": {
      "dependsOn": ["^lint"],
    },
    "test": {
      // Do not pass PUBLIRA_* here. The Dev Container exports a full
      // development environment, and most suites are hermetic; leaking those
      // values would couple them to ambient Redis, secrets, and API origins.
      // @publira/next-cache-handlers declares PUBLIRA_REDIS_URL on its own
      // test task so the Redis integration cases can see a configured URL.
      "inputs": ["**/*.test.{ts,tsx}"],
    },
    "typegen": {
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"],
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
    },
  },
}
