    "oxlint-plugin-react-doctor": "0.9.12",
    "turbo": "2.10.12",
    "typescript": "catalog:",
    "ultracite": "7.10.7"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
