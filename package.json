  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check",
    "design-tokens:check": "node scripts/check-design-tokens.ts",
    "dev": "turbo run dev",
    "docs:check": "node scripts/check-docs.ts",
    "fix": "ultracite fix",
    "jsx-svg:check": "node scripts/check-jsx-svg.ts",
    "locales:check": "node scripts/generate-locale-registry.ts --check",
    "locales:generate": "node scripts/generate-locale-registry.ts",
    "preflight": "pnpm locales:check && pnpm docs:check && pnpm design-tokens:check && pnpm jsx-svg:check && pnpm typecheck && pnpm check && pnpm reader-parity:check && pnpm test && pnpm test:scripts",
    "reader-parity:check": "node scripts/check-reader-parity.ts",
    "test": "turbo run test",
    "test:scripts": "node --test \"scripts/*.test.ts\"",
    "typecheck": "turbo run typecheck",
    "typegen": "turbo run typegen"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "4.2.2",
    "lefthook": "2.2.2",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "opentype.js": "2.0.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-plugin-react-doctor": "0.9.18",
    "sharp": "0.35.5",
    "temporal-polyfill": "catalog:",
    "turbo": "2.11.10",
    "typescript": "catalog:",
    "ultracite": "8.1.0",
    "vitest": "catalog:",
    "yaml": "2.9.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0"
