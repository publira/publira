    "fix": "ultracite fix",
    "locales:check": "node scripts/generate-locale-registry.ts --check",
    "locales:generate": "node scripts/generate-locale-registry.ts",
    "preflight": "pnpm locales:check && pnpm docs:check && pnpm typecheck && pnpm check && pnpm reader-parity:check && pnpm test && pnpm test:scripts",
    "reader-parity:check": "node scripts/check-reader-parity.ts",
    "test": "turbo run test",
    "test:scripts": "node --test \"scripts/*.test.ts\"",
    "typecheck": "turbo run typecheck",
    "typegen": "turbo run typegen"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "4.2.2",
    "lefthook": "2.2.2",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "opentype.js": "2.0.0",
    "oxfmt": "0.77.0",
    "oxlint": "catalog:",
    "oxlint-plugin-react-doctor": "0.9.22",
    "sharp": "0.35.5",
    "smol-toml": "1.9.1",
    "turbo": "2.11.10",
    "typescript": "catalog:",
    "ultracite": "8.1.1",
    "vitest": "catalog:",
    "yaml": "2.9.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
