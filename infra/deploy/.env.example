# Every variable compose.yaml reads. `publiractl env generate` copies this
# file to `.env` beside it with every secret below generated; fill in the
# image tag and the host names it leaves empty. `docker compose` refuses to
# start while a required value is empty. Which process receives each value,
# and under what name, is in README.md.

# The images, as `<registry>/<name>:<tag>`: the ones every release publishes,
# under the version of the release this checkout is at, which is its Git tag
# without the `v`, such as `0.1.0` for `v0.1.0`. An install
# that changes the code builds its own and names them here instead;
# `task docker:verify:full` builds them as `publira/<name>:local`.
PUBLIRA_IMAGE_REGISTRY=ghcr.io/publira
PUBLIRA_IMAGE_TAG=

# The ports the edge publishes on every interface of this host, for plain
# HTTP and for HTTPS. Keep 80 and 443 when the edge terminates TLS, since the
# certificate authority checks each host name on one of them.
PUBLIRA_EDGE_HTTP_PORT=80
PUBLIRA_EDGE_HTTPS_PORT=443

# The host names the edge routes to each web app, separated by spaces and
# without a port: every tenant's domain, every tenant's console host, and the
# Platform Console's host when `web-platform` runs. A host in no list reaches
# nothing, so adding a tenant adds its two host names here.
PUBLIRA_EDGE_SITE_HOSTS=
PUBLIRA_EDGE_ADMIN_HOSTS=
PUBLIRA_EDGE_PLATFORM_HOSTS=

# The contact address of the install's account at the certificate authority.
# Set, the edge terminates TLS: it obtains a certificate for every host above
# from Let's Encrypt, or from ZeroSSL when Let's Encrypt fails, renews it,
# serves HTTPS, and redirects plain HTTP there, which takes DNS for every host
# pointing here and both ports open to the internet. Empty, it serves plain
# HTTP alone, for a CDN or a load balancer in front that terminates TLS, or
# for trying the install on one machine.
PUBLIRA_EDGE_ACME_EMAIL=

# The addresses or CIDR ranges a CDN or a load balancer in front of the edge
# connects from, separated by spaces. The edge then records the client address
# that hop names in X-Forwarded-For. Empty, it trusts no one, and records
# every request with the address that connected to it, which is the reader's
# own when nothing is in front.
PUBLIRA_EDGE_TRUSTED_PROXIES=

# Scheme of tenant links. Empty means https.
PUBLIRA_TENANT_URL_SCHEME=

# The secrets, from here to the object store's credential, are the ones
# `publiractl env generate` fills in. A value set by hand instead has to be of
# the same shape: every database password goes into a connection URL
# unescaped, so use URL-safe characters only, such as `openssl rand -hex 32`.

# The PostgreSQL superuser, which `publiractl setup` and the `db` commands
# connect as.
PUBLIRA_POSTGRES_PASSWORD=

# One password per login role, set by `publiractl setup` or `db roles` and
# used in each process's connection URL.
PUBLIRA_PUBLIC_DB_PASSWORD=
PUBLIRA_ADMIN_DB_PASSWORD=
PUBLIRA_PLATFORM_DB_PASSWORD=
PUBLIRA_OUTBOX_DB_PASSWORD=
PUBLIRA_TICKER_DB_PASSWORD=
PUBLIRA_CONTENT_STATS_DB_PASSWORD=

# The keys that seal every stored secret, as `<key-id>:<base64 key>` pairs,
# such as `k1:$(openssl rand -base64 32)`, and the key new secrets are sealed
# with.
PUBLIRA_SECRET_ENCRYPTION_KEYS=
PUBLIRA_SECRET_ENCRYPTION_PRIMARY_KEY_ID=

# The key access tokens are signed with, at least 32 bytes, such as
# `openssl rand -base64 32`.
PUBLIRA_AUTH_JWT_SECRET=

# The keys each web app seals its session cookie with, at least 32 bytes each.
PUBLIRA_WEB_STOREFRONT_AUTH_SECRET=
PUBLIRA_WEB_ADMIN_AUTH_SECRET=

# The token `server` sends cache revalidation to the web apps with.
PUBLIRA_REVALIDATE_TOKEN=

# The token the consoles read tenant- and platform-level data from the server
# with, such as `openssl rand -base64 32`.
PUBLIRA_WEB_SERVICE_TOKEN=

# The object store's credential, which `publiractl setup` is given as well.
PUBLIRA_RUSTFS_ACCESS_KEY=
PUBLIRA_RUSTFS_SECRET_KEY=

# Optional processes, as a comma-separated list: `web-platform` for the
# Platform Console, `email-renderer` for the HTML part of every mail.
COMPOSE_PROFILES=

# With `web-platform`: http://web-platform:4100, the URL browsers reach the
# console on, and its session cookie key, which `publiractl env generate`
# fills in whether the profile runs or not.
PUBLIRA_WEB_PLATFORM_INTERNAL_URL=
PUBLIRA_PLATFORM_APP_URL=
PUBLIRA_WEB_PLATFORM_AUTH_SECRET=

# With `email-renderer`: http://email-renderer:8080.
PUBLIRA_EMAIL_RENDERER_URL=

# Optional OpenTelemetry export, off while empty. Tracing reaches every
# process but email-renderer, metrics only `server`, which hosts the worker; the
# OTEL_* values are read by the OpenTelemetry SDK under these names.
PUBLIRA_TRACING_ENABLED=
PUBLIRA_METRICS_ENABLED=
PUBLIRA_DEPLOYMENT_ENVIRONMENT=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=
OTEL_TRACES_SAMPLER=
OTEL_TRACES_SAMPLER_ARG=
OTEL_METRICS_EXPORTER=
OTEL_EXPORTER_PROMETHEUS_HOST=
