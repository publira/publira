# A sample of the routing in infra/proxy/README.md for Caddy, which a
# deployment adapts, and the edge of the Compose install in infra/deploy/,
# which runs it as it stands.
#
# Backend addresses come from the environment rather than from a second file:
# a Caddyfile substitutes {$VAR}, and the value after the first colon is the
# default. The defaults are the Dev Container's, where every backend is a
# process inside the one `app` container.
#
# So do the hosts each app answers: PUBLIRA_EDGE_SITE_HOSTS,
# PUBLIRA_EDGE_ADMIN_HOSTS, and PUBLIRA_EDGE_PLATFORM_HOSTS, and the tenants'
# image hosts, PUBLIRA_EDGE_IMAGE_HOSTS, which no app answers. Each is a list of
# host names separated by spaces. The substitution happens before the Caddyfile
# is parsed, so a list becomes that many arguments of its `host` matcher. None
# of them has a default.
#
# Every `host` matcher starts with `no/host`, a name no request can carry, since
# a Host header with a slash is refused before any matcher runs. Caddy rejects
# a `host` matcher with no names at all, and this one keeps the matcher valid
# when a list is empty: an install that runs no web-platform leaves
# PUBLIRA_EDGE_PLATFORM_HOSTS empty and keeps its block, and one that gives no
# tenant an image host leaves PUBLIRA_EDGE_IMAGE_HOSTS empty. A host may appear
# in one list only, since Caddy refuses a name repeated within one matcher, and
# @unlisted below names all four lists.
#
# Caddy has no equivalent of Traefik's numeric router priorities. `route`
# evaluates the handle blocks inside it in the order they are written, and
# they are mutually exclusive, so that order is the precedence.
#
# Caddy substitutes a default only for a variable that is unset, not for one
# set to an empty value, so every variable below without a default keeps the
# file valid when it is empty: a Compose file passes a variable `.env` leaves
# empty as set.
#
# TLS is chosen by PUBLIRA_EDGE_TLS_HOSTS. Empty, the site answers plain HTTP
# on :80 alone, which is what an edge behind a hop that terminates TLS serves.
# Set to every host name the four lists hold, separated by spaces, it adds
# them to the site's addresses, so Caddy obtains a certificate for each of
# them, renews it, and serves them on :443. Caddy also puts a redirect to
# HTTPS for each of them ahead of the routes on :80, which keeps answering
# every other host as before. The certificates are kept under /data, which a
# deployment keeps on a volume.

{
	# The contact address of the account Caddy registers with the certificate
	# authority. The quotes keep an empty value one argument, which registers
	# the account without one, since `email` takes exactly one.
	email "{$PUBLIRA_EDGE_ACME_EMAIL}"

	# A load balancer, a CDN, or a TLS terminator in front of this edge is the
	# peer of every request, so without this every request is recorded with
	# that hop's address. PUBLIRA_EDGE_TRUSTED_PROXIES lists the hop's own
	# addresses or CIDR ranges, separated by spaces, and no others; Caddy then
	# takes the client address from the X-Forwarded-For a request from them
	# carries: with `trusted_proxies_strict`, the rightmost address in it that
	# is not one of them. {client_ip} below becomes that address, and is the
	# peer address for requests from anywhere else, as it is for every request
	# while the list is empty. X-Forwarded-Proto from them is passed on as well,
	# since a TLS terminator reaches this edge over plain HTTP, and so is
	# X-Forwarded-CountryRegion, as the site block says.
	servers {
		trusted_proxies static {$PUBLIRA_EDGE_TRUSTED_PROXIES}
		trusted_proxies_strict
	}
}

# Applied to every proxied request. Caddy forwards the original Host header
# untouched, so only the rest is set here. X-Forwarded-Proto is left to
# reverse_proxy, which replaces it with this edge's scheme unless the request
# came from a proxy the global options trust, whose value it keeps.
(publira_forwarded) {
	header_up X-Forwarded-Host {http.request.hostport}
	# The client address travels in Forwarded (RFC 7239), replacing whatever
	# arrived: this is the trust boundary, and publira server finds the client
	# IP an access token and an audit log entry record in this header. It is
	# the peer address, or the one a hop the global options trust named, in
	# the form the map in the site block writes it.
	header_up Forwarded {publira_forwarded}
	# reverse_proxy writes an X-Forwarded-For of its own otherwise, appending
	# to the one a trusted hop sent, so it is removed and the client address
	# travels in Forwarded alone.
	header_up -X-Forwarded-For
	# W3C Trace Context ends here, so each backend opens a fresh root span
	# instead of adopting a trace the caller chose.
	header_up -traceparent
	header_up -tracestate
	header_up -baggage
}

:80 {$PUBLIRA_EDGE_TLS_HOSTS} {
	# The host matcher ignores the port the Host header carries, so
	# admin.localhost:3080 is a console host when admin.localhost is listed.
	@site host no/host {$PUBLIRA_EDGE_SITE_HOSTS}
	@admin host no/host {$PUBLIRA_EDGE_ADMIN_HOSTS}
	@platform host no/host {$PUBLIRA_EDGE_PLATFORM_HOSTS}
	@image_host host no/host {$PUBLIRA_EDGE_IMAGE_HOSTS}
	@unlisted not host no/host {$PUBLIRA_EDGE_SITE_HOSTS} {$PUBLIRA_EDGE_ADMIN_HOSTS} {$PUBLIRA_EDGE_PLATFORM_HOSTS} {$PUBLIRA_EDGE_IMAGE_HOSTS}

	@images path /images*

	# The reader's region travels in X-Forwarded-CountryRegion from a hop the
	# global options trust, which Caddy marks in the trusted_proxy variable,
	# and from no one else: Caddy looks up no region of its own, and a
	# caller's would name a region of their choosing. request_header runs
	# ahead of `route`, so no backend below is given the caller's.
	@untrusted_hop not vars {http.vars.trusted_proxy} true
	request_header @untrusted_hop -X-Forwarded-CountryRegion

	# The client address in the form Forwarded takes it, which the
	# publira_forwarded snippet sends: an IPv6 address has to be quoted and in
	# brackets, an IPv4 address goes as it is.
	map {client_ip} {publira_forwarded} {
		~: `for="[{client_ip}]"`
		default "for={client_ip}"
	}

	# The public API. The prefix ends at the dot after v1, so that
	# publira.v1.<Service>/<Method> is all it matches.
	@rpc path /rpc/publira.v1.*

	# The rest of /rpc is forwarded nowhere: what the server answers there is
	# the consoles' APIs, which web-admin and web-platform call over the
	# private network, so no host needs them.
	@console_api path /rpc /rpc/*

	route {
		# How many requests one client may send, as infra/proxy/README.md
		# lists them. The rate_limit handler is github.com/mholt/caddy-ratelimit,
		# which the caddy image ships without and refuses this file with the
		# lines uncommented, so they take a Caddy built with it, such as
		# `xcaddy build --with github.com/mholt/caddy-ratelimit`. Each zone lets
		# a client send `events` requests within any `window`, which is its
		# burst over the time its rate takes to refill it, and answers a request
		# past that with a 429 of its own, which no backend sees. {client_ip} is
		# the address a hop the global options trust named, or else the peer's.
		# The console hosts are in no zone: they are left to the server's own
		# limits.
		#
		# rate_limit {
		# 	zone api {
		# 		match {
		# 			host no/host {$PUBLIRA_EDGE_SITE_HOSTS}
		# 			path /rpc/publira.v1.*
		# 			not path /rpc/publira.v1.CatalogService/SearchPublished*
		# 		}
		# 		key {client_ip}
		# 		events 120
		# 		window 6s
		# 	}
		# 	zone search_rpc {
		# 		match {
		# 			host no/host {$PUBLIRA_EDGE_SITE_HOSTS}
		# 			path /rpc/publira.v1.CatalogService/SearchPublished*
		# 		}
		# 		key {client_ip}
		# 		events 20
		# 		window 10s
		# 	}
		# 	zone search_page {
		# 		match {
		# 			host no/host {$PUBLIRA_EDGE_SITE_HOSTS}
		# 			path_regexp ^(/[a-z]{2}(-[A-Za-z]{4})?)?/search/?$
		# 		}
		# 		key {client_ip}
		# 		events 20
		# 		window 10s
		# 	}
		# 	zone images {
		# 		match {
		# 			host no/host {$PUBLIRA_EDGE_SITE_HOSTS} {$PUBLIRA_EDGE_IMAGE_HOSTS}
		# 			path /images*
		# 		}
		# 		key {client_ip}
		# 		events 600
		# 		window 10s
		# 	}
		# }

		# A host in no list: the edge answers it itself, and no backend sees
		# the request, /rpc and /images included. Over HTTPS no request for
		# such a host gets this far: Caddy has no certificate for it, so the TLS
		# handshake fails.
		handle @unlisted {
			respond 404
		}

		# On every listed host, a tenant's image host among them, and answered
		# by the same process as the API, with the path as it is: the server's
		# own routes carry /images.
		handle @images {
			reverse_proxy {$PUBLIRA_UPSTREAM_API:app:8000} {
				import publira_forwarded
			}
		}

		# The rest of an image host, /rpc included: no app serves it, so the
		# edge answers it itself.
		handle @image_host {
			respond 404
		}

		# The public API, reached with the path as it is: the server's own
		# routes carry /rpc.
		handle @rpc {
			reverse_proxy {$PUBLIRA_UPSTREAM_API:app:8000} {
				import publira_forwarded
			}
		}

		# The consoles' APIs: the edge answers them itself, on every listed
		# host, and no backend sees the request.
		handle @console_api {
			respond 404
		}

		handle @admin {
			reverse_proxy {$PUBLIRA_UPSTREAM_WEB_ADMIN:app:4000} {
				import publira_forwarded
			}
		}

		# An install that runs no web-platform leaves PUBLIRA_EDGE_PLATFORM_HOSTS
		# empty, and this block then answers nothing.
		handle @platform {
			reverse_proxy {$PUBLIRA_UPSTREAM_WEB_PLATFORM:app:4100} {
				import publira_forwarded
			}
		}

		handle @site {
			reverse_proxy {$PUBLIRA_UPSTREAM_WEB_STOREFRONT:app:3000} {
				import publira_forwarded
			}
		}
	}
}
