# A sample of the routing in infra/proxy/README.md for Caddy, which a
# deployment adapts.
#
# Backend addresses come from the environment rather than from a second file:
# a Caddyfile substitutes {$VAR}, and the value after the first colon is the
# default. The defaults are the Dev Container's, where every backend is a
# process inside the one `app` container.
#
# So do the hosts each app answers: PUBLIRA_EDGE_SITE_HOSTS,
# PUBLIRA_EDGE_ADMIN_HOSTS, and PUBLIRA_EDGE_PLATFORM_HOSTS, each a list of host
# names separated by spaces. The substitution happens before the Caddyfile is
# parsed, so a list becomes that many arguments of its `host` matcher. None of
# them has a default.
#
# Every `host` matcher starts with `no/host`, a name no request can carry, since
# a Host header with a slash is refused before any matcher runs. Caddy rejects
# a `host` matcher with no names at all, and this one keeps the matcher valid
# when a list is empty: an install that runs no web-platform leaves
# PUBLIRA_EDGE_PLATFORM_HOSTS empty and keeps its block. A host may appear in
# one list only, since Caddy refuses a name repeated within one matcher, and
# @unlisted below names all three lists.
#
# Caddy has no equivalent of Traefik's numeric router priorities. `route`
# evaluates the handle blocks inside it in the order they are written, and
# they are mutually exclusive, so that order is the precedence.

{
	# The site below listens on plain HTTP. A deployment terminates TLS by
	# giving the site block its host names instead of `:80`, at which point
	# Caddy obtains certificates on its own; `tls <email>` or `tls <cert>
	# <key>` chooses another source.
	auto_https off

	# A load balancer, a CDN, or a TLS terminator in front of this edge is the
	# peer of every request, so without this every request is recorded with
	# that hop's address. Listing the hop's own addresses, and no others, makes
	# Caddy take the client address from the X-Forwarded-For a request from
	# them carries: with `trusted_proxies_strict`, the rightmost address in it
	# that is not one of them. {client_ip} below becomes that address, and is
	# the peer address for requests from anywhere else, as it is without this.
	# X-Forwarded-Proto from them is passed on as well, since a TLS terminator
	# reaches this edge over plain HTTP.
	#
	# servers {
	# 	trusted_proxies static 192.0.2.0/24
	# 	trusted_proxies_strict
	# }
}

# Applied to every proxied request. Caddy forwards the original Host header
# untouched, so only the rest is set here. X-Forwarded-Proto is left to
# reverse_proxy, which replaces it with this edge's scheme unless the request
# came from a proxy the global options trust, whose value it keeps.
(publira_forwarded) {
	header_up X-Forwarded-Host {http.request.hostport}
	# The client address travels in Forwarded (RFC 7239), replacing whatever
	# arrived: this is the trust boundary, and publira server finds the client
	# IP an access token and an audit log entry record in this header. It is
	# the peer address, or the one a hop the global options trust named, in
	# the form the map in the site block writes it.
	header_up Forwarded {publira_forwarded}
	# reverse_proxy writes an X-Forwarded-For of its own otherwise, appending
	# to the one a trusted hop sent, so it is removed and the client address
	# travels in Forwarded alone.
	header_up -X-Forwarded-For
	# W3C Trace Context ends here, so each backend opens a fresh root span
	# instead of adopting a trace the caller chose.
	header_up -traceparent
	header_up -tracestate
	header_up -baggage
}

:80 {
	# The host matcher ignores the port the Host header carries, so
	# admin.localhost:3080 is a console host when admin.localhost is listed.
	@site host no/host {$PUBLIRA_EDGE_SITE_HOSTS}
	@admin host no/host {$PUBLIRA_EDGE_ADMIN_HOSTS}
	@platform host no/host {$PUBLIRA_EDGE_PLATFORM_HOSTS}
	@unlisted not host no/host {$PUBLIRA_EDGE_SITE_HOSTS} {$PUBLIRA_EDGE_ADMIN_HOSTS} {$PUBLIRA_EDGE_PLATFORM_HOSTS}

	@images path /images*

	# The client address in the form Forwarded takes it, which the
	# publira_forwarded snippet sends: an IPv6 address has to be quoted and in
	# brackets, an IPv4 address goes as it is.
	map {client_ip} {publira_forwarded} {
		~: `for="[{client_ip}]"`
		default "for={client_ip}"
	}

	# Everything under /api except the Next.js Route Handlers on /api/v1:
	# /api/v1/revalidate on every app, plus the view beacon, the read beacon,
	# and the payment and inbound email webhooks on the public site.
	@api {
		path /api /api/*
		not path /api/v1 /api/v1/*
	}

	route {
		# A host in no list: the edge answers it itself, and no backend sees
		# the request, /api and /images included.
		handle @unlisted {
			respond 404
		}

		# On every listed host, like the API, and answered by the same
		# process, with the path as it is: the server's own routes carry
		# /images.
		handle @images {
			reverse_proxy {$PUBLIRA_UPSTREAM_API:app:8000} {
				import publira_forwarded
			}
		}

		# The public API, reached with the path as it is: the server's own
		# routes carry /api.
		handle @api {
			reverse_proxy {$PUBLIRA_UPSTREAM_API:app:8000} {
				import publira_forwarded
			}
		}

		handle @admin {
			reverse_proxy {$PUBLIRA_UPSTREAM_WEB_ADMIN:app:4000} {
				import publira_forwarded
			}
		}

		# An install that runs no web-platform leaves PUBLIRA_EDGE_PLATFORM_HOSTS
		# empty, and this block then answers nothing.
		handle @platform {
			reverse_proxy {$PUBLIRA_UPSTREAM_WEB_PLATFORM:app:4100} {
				import publira_forwarded
			}
		}

		handle @site {
			reverse_proxy {$PUBLIRA_UPSTREAM_WEB_HOST:app:3000} {
				import publira_forwarded
			}
		}
	}
}
