# syntax=docker/dockerfile:1.23@sha256:2780b5c3bab67f1f76c781860de469442999ed1a0d7992a5efdf2cffc0e3d769

# Batch template for server/cmd/* one-shot jobs.
#
# Build example:
# docker build \
#   -f infra/docker/templates/Dockerfile.batch \
#   --build-arg CMD_NAME=publish-episodes \
#   --build-arg BINARY_NAME=publish-episodes \
#   -t publira/publish-episodes:local \
#   .

FROM debian:bookworm-slim@sha256:4724b8cc51e33e398f0e2e15e18d5ec2851ff0c2280647e1310bc1642182655d AS builder

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates golang && rm -rf /var/lib/apt/lists/*
WORKDIR /src

COPY server/go.mod server/go.sum ./server/
RUN cd server && go mod download

COPY server ./server

ARG CMD_NAME
ARG BINARY_NAME

RUN cd server && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
  go build -trimpath -ldflags='-s -w' -o /out/${BINARY_NAME} ./cmd/${CMD_NAME}

FROM gcr.io/distroless/static:nonroot@sha256:e3f945647ffb95b5839c07038d64f9811adf17308b9121d8a2b87b6a22a80a39

ARG BINARY_NAME

WORKDIR /app

COPY --from=builder /out/${BINARY_NAME} /app/${BINARY_NAME}

USER nonroot

ENTRYPOINT ["/app/${BINARY_NAME}"]
