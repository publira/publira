{
  "registry-mirrors": ["https://mirror.gcr.io"],
  "builder": {
    "gc": {
      "enabled": true,
      "policy": [
        {
          "maxUsedSpace": "512MB",
          "filter": ["type=source.local", "unused-for=48h"]
        },
        { "maxUsedSpace": "10GB", "filter": ["unused-for=168h"] },
        { "maxUsedSpace": "10GB", "all": true }
      ]
    }
  }
}
