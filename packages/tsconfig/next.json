{
  "extends": "./base.json",
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // Matches `base.json`. Nothing is emitted from here, and `ES2017` rejects
    // the bigint literals oxlint's `unicorn/prefer-bigint-literals` requires.
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true
  }
}
