{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "esModuleInterop": true,
    // `esnext.temporal` is what types `Temporal`, which this repository uses in
    // place of `Date`. It is types only: Node.js implements `Temporal` itself,
    // and the browser bundles of the Next.js apps import
    // `temporal-polyfill/global` from `instrumentation-client.ts`.
    "lib": ["dom", "es2024", "esnext.temporal"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024"
  }
}
