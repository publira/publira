{
  "dynamic": "strict",
  "dynamic_templates": [
    {
      "latest_episode_at": {
        "path_match": "latest_episode_at.*",
        "mapping": { "type": "date_nanos" }
      }
    }
  ],
  "properties": {
    "kind": { "type": "keyword" },
    "tenant_id": { "type": "keyword" },
    "entity_id": { "type": "keyword" },
    "surfaces": { "type": "keyword" },
    "published_at": { "type": "date_nanos" },
    "title": {
      "type": "text",
      "analyzer": "written_form",
      "fields": {
        "reading": { "type": "text", "analyzer": "alternate_form" },
        "keyword": { "type": "keyword", "normalizer": "exact_match" },
        "sort": { "type": "keyword" }
      }
    },
    "synopsis": { "type": "text", "analyzer": "written_form" },
    "name": {
      "type": "text",
      "analyzer": "written_form",
      "fields": {
        "reading": { "type": "text", "analyzer": "alternate_form" },
        "keyword": { "type": "keyword", "normalizer": "exact_match" }
      }
    },
    "reading": { "type": "text", "analyzer": "alternate_form" },
    "genre_public_ids": { "type": "keyword" },
    "tag_slugs": { "type": "keyword" },
    "status": { "type": "keyword" },
    "schedule_weekdays": { "type": "short" },
    "free_episode_surfaces": { "type": "keyword" },
    "latest_episode_at": { "type": "object", "dynamic": true }
  }
}
