{
  "permissions": {
    "allow": [
      "Bash(pnpm preflight)",
      "Bash(pnpm preflight *)",
      "Bash(pnpm check)",
      "Bash(pnpm check *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm typegen)",
      "Bash(pnpm typegen *)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm run test *)",
      "Bash(pnpm fix)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/worktree-deps.ts\"",
            "timeout": 900
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/worktree-deps.ts\"",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
