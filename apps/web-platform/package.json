{
  "name": "@publira/web-platform",
  "version": "0.1.0",
  "private": true,
  "description": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/publira/publira.git",
    "directory": "apps/web-platform"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./lib/*",
    "#components/*": "./components/*"
