{
  "extends": "@publira/tsconfig/next.json",
  "compilerOptions": {
    "paths": {
      "#lib/*": ["./lib/*"],
      "#components/*": ["./components/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
