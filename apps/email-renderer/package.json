{
  "name": "@publira/email-renderer",
  "version": "0.1.0",
  "private": true,
  "description": "ConnectRPC service that renders Publira email templates",
  "repository": {
    "type": "git",
    "url": "https://github.com/publira/publira.git",
    "directory": "apps/email-renderer"
  },
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsdown",
    "dev": "node --watch src/index.ts",
    "start": "node dist/index.mjs",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2",
    "@publira/api-client": "workspace:*",
    "@publira/email-templates": "workspace:*",
    "@publira/i18n": "workspace:*",
    "temporal-polyfill": "catalog:"
  },
  "devDependencies": {
    "@publira/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
