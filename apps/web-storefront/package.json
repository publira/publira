{
  "name": "@publira/web-storefront",
  "version": "0.5.1",
  "private": true,
  "description": "Public tenant site: catalog delivery, reader authentication, and account pages",
  "repository": {
    "type": "git",
    "url": "https://github.com/publira/publira.git",
    "directory": "apps/web-storefront"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./lib/*",
    "#components/*": "./components/*"
  },
  "scripts": {
    "build": "next build",
    "dev": "PNCH_CACHE_APP=web-storefront next dev --port ${PORT:-3000}",
    "start": "PNCH_CACHE_APP=web-storefront next start",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "typegen": "next typegen"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@next/third-parties": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@publira/api-client": "workspace:*",
    "@publira/brand": "workspace:*",
    "@publira/comic-viewer": "catalog:",
    "@publira/comic-viewer-shell": "workspace:*",
    "@publira/i18n": "workspace:*",
    "@publira/icons": "workspace:*",
    "@publira/layouts": "workspace:*",
    "@publira/next-cache-handlers": "catalog:",
    "@publira/tracing": "workspace:*",
    "@publira/ui-components": "workspace:*",
    "@publira/utils": "workspace:*",
    "@publira/web-session": "workspace:*",
    "@simplewebauthn/browser": "catalog:",
    "lru-cache": "catalog:",
    "next": "catalog:",
    "p-retry": "8.0.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwindcss": "catalog:",
    "temporal-polyfill": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@publira/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "schema-dts": "2.1.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
