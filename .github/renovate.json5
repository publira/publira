{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>publira/.github//renovate.json5"],
  // `customManagers` is a mergeable array, so these append to the org preset's
  // managers rather than replacing them. Each entry carries the `depName` of the
  // pin it belongs to, so everything derived from that pin lands in one Renovate
  // branch; the `v` sits inside the capture only where the datasource is `go`,
  // which is the one that returns v-prefixed versions.
  customManagers: [
    // buf has no Renovate manager, so the remote plugin pins in buf.gen.yaml
    // would silently go stale. Each pin tracks the runtime library the generated
    // code is compiled against, hence the same packages as server/go.mod and
    // packages/api-client/package.json.
    {
      customType: "regex",
      description: "buf.gen.yaml remote plugins backed by a Go module.",
      managerFilePatterns: ["/^buf\\.gen\\.yaml$/"],
      matchStrings: [
        "# renovate: datasource=go depName=(?<depName>\\S+)\\s+- remote: \\S+:(?<currentValue>v\\S+)",
      ],
      datasourceTemplate: "go",
    },
    {
      customType: "regex",
      description: "buf.gen.yaml remote plugins backed by an npm package.",
      managerFilePatterns: ["/^buf\\.gen\\.yaml$/"],
      matchStrings: [
        "# renovate: datasource=npm depName=(?<depName>\\S+)\\s+- remote: \\S+:v(?<currentValue>\\S+)",
      ],
      datasourceTemplate: "npm",
    },
    // Each generator stamps its version into every file it writes, so for a
    // release that changes nothing else the stamps are the whole regeneration.
    // The stamp itself is the match target because a `# renovate:` annotation
    // would not survive the generator's next run.
    {
      customType: "regex",
      description: "sqlc version stamp in the generated Go queries.",
      // `*.go`, not `*.sql.go`: db.go, models.go, and querier.go are stamped too.
      managerFilePatterns: ["server/internal/db/gen/*.go"],
      matchStrings: ["// versions:\\s+//\\s+sqlc v(?<currentValue>\\S+)"],
      depNameTemplate: "sqlc-dev/sqlc",
      datasourceTemplate: "github-releases",
      versioningTemplate: "semver-coerced",
    },
    {
      customType: "regex",
      description: "protoc-gen-go version stamp in the generated Go messages.",
      managerFilePatterns: ["server/internal/proto/gen/**/*.pb.go"],
      matchStrings: [
        "// versions:\\s+//\\s+protoc-gen-go (?<currentValue>v\\S+)",
      ],
      depNameTemplate: "google.golang.org/protobuf",
      datasourceTemplate: "go",
    },
    {
      customType: "regex",
      description: "protoc-gen-es version stamp in the generated TypeScript messages.",
      managerFilePatterns: ["packages/api-client/src/gen/**/*_pb.ts"],
      matchStrings: ["// @generated by protoc-gen-es v(?<currentValue>\\S+)"],
      depNameTemplate: "@bufbuild/protobuf",
      datasourceTemplate: "npm",
    },
  ],
}
