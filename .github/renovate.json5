{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>publira/.github//renovate.json5"],
  packageRules: [
    {
      // packages/tracing declares these only to satisfy @vercel/otel's peer
      // dependencies, which stay below opentelemetry-js 3.x. @vercel/otel
      // bundles its own 2.x copies, so a 3.x declaration runs nothing new while
      // leaving the peers unmet and typing the options it accepts against the
      // wrong classes. Lifted by #4821.
      matchPackageNames: [
        "@opentelemetry/resources",
        "@opentelemetry/sdk-logs",
        "@opentelemetry/sdk-metrics",
      ],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
  ],
  // `customManagers` is a mergeable array, so these append to the org preset's
  // managers rather than replacing them. Each entry carries the `depName` of the
  // pin it belongs to, so everything derived from that pin lands in one Renovate
  // branch; the `v` sits inside the capture only where the datasource returns
  // v-prefixed versions.
  customManagers: [
    // Each generator stamps its version into every file it writes, so for a
    // release that changes nothing else the stamps are the whole regeneration.
    // The stamp itself is the match target because a `# renovate:` annotation
    // would not survive the generator's next run. A protoc plugin's stamp is
    // looked up as the buf.gen.yaml pin that writes it, through the org
    // preset's `buf-plugin` datasource, rather than as the runtime library: the
    // library can be raised before the Buf Schema Registry publishes the
    // plugin, and a stamp ahead of the pin fails the regeneration check.
    {
      customType: "regex",
      description: "sqlc version stamp in the generated Go queries.",
      // `*.go`, not `*.sql.go`: db.go, models.go, and querier.go are stamped too.
      managerFilePatterns: ["server/internal/db/gen/*.go"],
      matchStrings: ["// versions:\\s+//\\s+sqlc v(?<currentValue>\\S+)"],
      depNameTemplate: "sqlc-dev/sqlc",
      datasourceTemplate: "github-releases",
      versioningTemplate: "semver-coerced",
    },
    {
      customType: "regex",
      description: "protoc-gen-go version stamp in the generated Go messages.",
      managerFilePatterns: ["server/internal/proto/gen/**/*.pb.go"],
      matchStrings: [
        "// versions:\\s+//\\s+protoc-gen-go (?<currentValue>v\\S+)",
      ],
      depNameTemplate: "buf.build/protocolbuffers/go",
      datasourceTemplate: "custom.buf-plugin",
    },
    {
      customType: "regex",
      description: "protoc-gen-es version stamp in the generated TypeScript messages.",
      managerFilePatterns: ["packages/api-client/src/gen/**/*_pb.ts"],
      matchStrings: ["// @generated by protoc-gen-es (?<currentValue>v\\S+)"],
      depNameTemplate: "buf.build/bufbuild/es",
      datasourceTemplate: "custom.buf-plugin",
    },
    {
      customType: "regex",
      // The org preset's `# renovate:` annotation carries a version alone, and
      // the tarball is pinned by its checksum too. The datasource reads the new
      // checksum from the attachments of the release it moves to.
      description: "libvips source release the publira image builds, with its checksum.",
      managerFilePatterns: ["infra/docker/server/Dockerfile"],
      matchStrings: [
        "ARG LIBVIPS_VERSION=(?<currentValue>v\\S+)\\s+ARG LIBVIPS_SHA256=(?<currentDigest>[0-9a-f]{64})",
      ],
      depNameTemplate: "libvips/libvips",
      datasourceTemplate: "github-release-attachments",
      versioningTemplate: "semver-coerced",
    },
  ],
}
